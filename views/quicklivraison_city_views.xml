<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quicklivraison_city_view_list" model="ir.ui.view">
        <field name="name">quicklivraison.city.list</field>
        <field name="model">quicklivraison.city</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="external_id"/>
                <field name="name"/>
                <field name="fee"/>
                <field name="delivery_time"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="quicklivraison_city_action" model="ir.actions.act_window">
        <field name="name">Quick Livraison Cities</field>
        <field name="res_model">quicklivraison.city</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
